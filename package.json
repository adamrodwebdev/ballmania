{
  "name": "ballmania",
  "version": "1.7.5",
  "private": true,
  "description": "Jeu de tir de billes en chaîne réinventé : campagne, nouveaux modes, destruction spectaculaire, en français, anglais, indonésien et russe. Vue 3, TypeScript, mobile d'abord.",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "dev:portal": "vite --mode simulated",
    "build": "vue-tsc --noEmit -p tsconfig.app.json && vite build",
    "build:crazygames": "vue-tsc --noEmit -p tsconfig.app.json && vite build --mode crazygames",
    "build:poki": "vue-tsc --noEmit -p tsconfig.app.json && vite build --mode poki",
    "build:gamedistribution": "vue-tsc --noEmit -p tsconfig.app.json && vite build --mode gamedistribution",
    "build:playgama": "vue-tsc --noEmit -p tsconfig.app.json && vite build --mode playgama",
    "build:portals": "npm run build:crazygames && npm run build:poki && npm run build:gamedistribution && npm run build:playgama",
    "build:demo": "vue-tsc --noEmit -p tsconfig.app.json && vite build --mode demo",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "vue-tsc --noEmit -p tsconfig.vitest.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lighthouse": "node scripts/lighthouse.mjs",
    "verify": "npm run lint && npm run format:check && npm run typecheck && npm run test && npm run build",
    "kit:crazygames": "node marketing/crazygames/render.mjs"
  },
  "dependencies": {
    "@fontsource/fredoka": "5.3.0",
    "@fontsource/lilita-one": "5.3.0",
    "swiper": "14.3.0",
    "vue": "3.5.43",
    "vue-i18n": "11.4.14"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@intlify/unplugin-vue-i18n": "11.2.5",
    "@playwright/test": "1.64.0",
    "@types/node": "24.13.4",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/eslint-config-prettier": "10.2.0",
    "@vue/eslint-config-typescript": "14.9.0",
    "@vue/tsconfig": "0.9.1",
    "chrome-launcher": "1.2.2",
    "eslint": "10.12.0",
    "eslint-plugin-vue": "10.11.1",
    "jiti": "2.7.0",
    "lighthouse": "13.5.0",
    "mp4-muxer": "5.2.2",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.4",
    "vue-tsc": "3.3.13"
  }
}
