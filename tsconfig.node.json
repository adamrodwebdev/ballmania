{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true
  },
  "include": [
    "vite.config.ts",
    "src/platform/platforms.ts",
    "playwright.config.ts",
    "eslint.config.ts",
    "e2e/**/*.ts"
  ]
}
